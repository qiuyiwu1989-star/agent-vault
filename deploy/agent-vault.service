[Unit]
Description=Agent Vault production management
After=network.target postgresql.service
[Service]
Type=simple
User=agentvault
Group=www-data
WorkingDirectory=/opt/agent-vault
Environment=PYTHONPATH=/opt/agent-vault/src
ExecStart=/usr/bin/python3 -m agent_vault.production
Restart=on-failure
UMask=0002
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/html/vault
[Install]
WantedBy=multi-user.target
